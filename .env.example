# ==============================================================================
# BUZZER MEDIA BACKEND - ENVIRONMENT VARIABLES
# ==============================================================================

PORT=8080

# ------------------------------------------------------------------------------
# SUPABASE ADAPTER CONFIGURATION
# ------------------------------------------------------------------------------
# Dapatkan kredensial ini di Dashboard Supabase: Project Settings -> API
# 1. Project URL (cth: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Service Role Secret Key (Wajib untuk bypass RLS pada backend server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# 3. Anon Public Key (Opsional fallback)
SUPABASE_KEY=your-supabase-anon-key-here

# 4. PostgreSQL Direct Connection String (Opsional untuk psql migration)
DATABASE_URL=postgres://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
